# Salin menjadi .env (sudah di-ignore git). Jangan pernah meng-commit kunci asli.

# Wajib untuk stage Ask AI (fungsi serverless api/chat.js): token gateway Vulpes
# (project Gemini-Gateway) - nilainya sama dengan GATEWAY_TOKEN di gateway itu.
GATEWAY_TOKEN=

# Opsional: alamat gateway. Kosong = https://vulpes-core.vercel.app
# GATEWAY_URL=https://vulpes-core.vercel.app

# Opsional: alamat produksi tanpa garis miring di ujung, untuk canonical dan kartu pratinjau.
# Di Vercel tidak perlu diisi - VERCEL_PROJECT_PRODUCTION_URL dipakai otomatis.
# SITE_URL=https://contoh.com
